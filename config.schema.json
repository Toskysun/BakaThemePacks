{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "BakaMusic Theme Config",
    "description": "BakaMusic 主题包配置（bakamusic-theme@2）",
    "type": "object",
    "required": ["spec", "name", "author", "preview", "description", "version", "tags"],
    "properties": {
        "spec": {
            "type": "string",
            "const": "bakamusic-theme@2",
            "description": "主题契约版本，必须为 bakamusic-theme@2"
        },
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "主题显示名称"
        },
        "author": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "作者名称"
        },
        "authorUrl": {
            "type": "string",
            "format": "uri",
            "description": "作者主页链接"
        },
        "preview": {
            "type": "string",
            "minLength": 1,
            "description": "预览图路径（@/imgs/文件名）或 CSS 颜色（#xxx）"
        },
        "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "主题描述"
        },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "semver 版本号"
        },
        "scheme": {
            "type": "string",
            "enum": ["light", "dark"],
            "description": "对比基调，应与 --theme-scheme 一致"
        },
        "tags": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "maxItems": 5,
            "description": "标签（取自 tags.json）"
        },
        "iframe": {
            "type": "object",
            "properties": {
                "app": {
                    "type": "string",
                    "description": "动态背景 HTML（@/iframes/*.html）"
                }
            },
            "required": ["app"],
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
